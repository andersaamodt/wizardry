#!/bin/sh

# This spell lists all contacts in the contacts directory.
# Each vCard file is parsed to extract the name, organization, or telephone.

case "${1-}" in
--help|--usage|-h)
  cat << 'USAGE'
Usage: list-contacts [directory]

List contacts from vCard files in a directory, defaulting to ~/.contacts when none is provided.
USAGE
  exit 0
  ;;
esac

set -eu
. env-clear

# Default contacts directory
contacts_dir="${1:-$HOME/.contacts}"

# Ensure the contacts directory exists
mkdir -p "$contacts_dir"

# Find all vCard files in the contacts directory (POSIX-compliant)
find "$contacts_dir" -name '*.vcf' | while IFS= read -r file; do
  # Skip if file doesn't exist (empty directory case)
  [ -f "$file" ] || continue
  
  # Attempt to extract the FN, ORG, or TEL field from the vCard
  name=$(
    awk '
      function unescape(value) {
        gsub(/\\n/, "\n", value)
        gsub(/\\,/, ",", value)
        gsub(/\\;/, ";", value)
        gsub(/\\\\/, "\\", value)
        return value
      }
      function process_line(line, colon_pos, field_name, field_value) {
        if (line == "") {
          return
        }
        colon_pos = index(line, ":")
        if (colon_pos < 1) {
          return
        }
        field_name = substr(line, 1, colon_pos - 1)
        sub(/;.*/, "", field_name)
        field_value = substr(line, colon_pos + 1)
        if (field_name == "FN" && name == "") {
          name = unescape(field_value)
          return
        }
        if (field_name == "ORG" && org == "") {
          org = unescape(field_value)
          return
        }
        if (field_name == "TEL" && tel == "") {
          tel = unescape(field_value)
        }
      }
      {
        sub(/\r$/, "", $0)
        if ($0 ~ /^[[:space:]]/) {
          current = current substr($0, 2)
          next
        }
        process_line(current)
        current = $0
      }
      END {
        process_line(current)
        if (name != "") {
          print name
        } else if (org != "") {
          print org
        } else if (tel != "") {
          print tel
        }
      }
    ' "$file"
  )

  if [ -z "$name" ]; then
    # No name, organization, or telephone found, print the filename
    name="<$(basename "$file")>"
  fi

  printf '%s\n' "$name"
done | sort
