#!/bin/sh
# Rewrite broad checklist work into narrow, file-scoped architecture items.
# Local-only: delegates intelligence to OpenCode with a local provider.

case "${1-}" in
--help|--usage|-h)
  cat <<'USAGE'
Usage: architect [CHECKLIST] [--model ollama/qwen3.6:35b-a3b]

Rewrites broad unchecked checklist items into narrow, file-scoped,
verifiable architecture items. The checklist file is the only file architect
edits. Completed [x] items are preserved exactly.

architect is local-only. It delegates to OpenCode, but only with a local model
provider such as ollama/* or mlx/*; remote providers are rejected.

When CHECKLIST is omitted, architect defaults to CHECKLIST.md if present,
otherwise checklist.md.
USAGE
  exit 0
  ;;
esac

require-wizardry || exit 1

set -eu
. env-clear

checklist=''
model='ollama/qwen3.6:35b-a3b'

while [ "$#" -gt 0 ]; do
  case "$1" in
  --model)
    shift
    [ "$#" -gt 0 ] || die 2 "architect: --model requires a value"
    model=$1
    ;;
  --local)
    ;;
  --remote)
    die 2 "architect: remote mode is not supported; architect is local-only"
    ;;
  --*)
    die 2 "architect: unknown option '$1'"
    ;;
  *)
    [ -z "$checklist" ] || die 2 "architect: unexpected argument '$1'"
    checklist=$1
    ;;
  esac
  shift
done

case "$model" in
ollama/*|mlx/*)
  ;;
*)
  die 2 "architect: --model must name a local OpenCode model such as ollama/qwen3.6:35b-a3b"
  ;;
esac

if [ -z "$checklist" ]; then
  if [ -f CHECKLIST.md ]; then
    checklist=CHECKLIST.md
  elif [ -f checklist.md ]; then
    checklist=checklist.md
  else
    die 2 "architect: checklist file is required; expected CHECKLIST.md or checklist.md"
  fi
fi

[ -f "$checklist" ] || die "architect: checklist is not a regular file: $checklist"
[ -r "$checklist" ] || die "architect: checklist is not readable: $checklist"
[ -w "$checklist" ] || die "architect: checklist is not writable: $checklist"
command -v opencode >/dev/null 2>&1 || die 127 "architect: opencode is not installed"

provider=${model%%/*}
if ! opencode models "$provider" 2>/dev/null | grep -F -- "$model" >/dev/null 2>&1; then
  die "architect: local OpenCode model is not configured: $model"
fi

checklist_dir=$(CDPATH= cd -- "$(dirname "$checklist")" && pwd -P)
checklist_name=${checklist##*/}
checklist_path=$checklist_dir/$checklist_name
architect_tmp_dir=${TMPDIR:-/tmp}/wizardry-architect-$$
completed_file=$architect_tmp_dir/completed.txt
broad_file=$architect_tmp_dir/broad-unchecked.txt
bad_file=$architect_tmp_dir/bad.txt
unchecked_file=$architect_tmp_dir/unchecked.txt
paths_file=$architect_tmp_dir/paths.txt
prompt_file=$architect_tmp_dir/prompt.txt
tree_file=$architect_tmp_dir/tree.txt
bt=$(printf '\140')

cleanup_architect_tmp() {
  rm -rf "$architect_tmp_dir"
}
trap cleanup_architect_tmp EXIT HUP INT TERM

mkdir -p "$architect_tmp_dir"
grep -E '^[[:space:]]*[-*][[:space:]]+\[[xX]\][[:space:]]' "$checklist_path" \
  >"$completed_file" 2>/dev/null || :
grep -E '^[[:space:]]*[-*][[:space:]]+\[ \][[:space:]]' "$checklist_path" \
  | grep -F -v "$bt" >"$broad_file" 2>/dev/null || :

(
  CDPATH= cd -- "$checklist_dir" || exit 1
  find . \
    \( -name .git -o -name node_modules -o -name .cache -o -name .next \
      -o -name dist -o -name build -o -name target -o -name __pycache__ \
      -o -name .venv -o -name venv \) -prune \
    -o -type f -print 2>/dev/null \
    | sed 's#^\./##' \
    | LC_ALL=C sort \
    | awk 'NR <= 500 { print }'
) >"$tree_file"

cat >"$prompt_file" <<EOF
You are the local wizardry architect spell. Your only job is to improve one
checklist plan; do not implement code.

Repository directory:
$checklist_dir

Checklist file:
$checklist_name

Read AGENTS.md if present, read $checklist_name, and inspect the repository
files needed to understand the broad unchecked checklist items.

Edit only $checklist_name. Do not edit source files, tests, docs, config, or
generated files.

Rewrite rules:
- Preserve every completed [x] checklist line byte-for-byte.
- Preserve useful headings and notes.
- Replace broad unchecked [ ] items with narrow unchecked [ ] items.
- If you split a broad item, remove the original broad unchecked line.
- Keep a flat checklist only; no nested checklist items.
- Do not mark new or rewritten items complete.
- Each new unchecked item must be one line starting exactly "- [ ] ".
- Each new unchecked item must name exactly one existing repository file path.
- Each new unchecked item must include exactly one single-line verification
  command in backticks.
- Do not wrap file paths in backticks; reserve backticks only for the one
  verification command.
- Use this exact shape:
  - [ ] Add specific change to src/example.js; verify with ${bt}node --check src/example.js${bt}
- Invalid: "- [ ] Add change to src/example.js (verify: node --check src/example.js)"
- Invalid: "- [ ] Add change to ${bt}src/example.js${bt}; verify with ${bt}node --check src/example.js${bt}"
- Do not use Markdown code fences.
- Do not use heredocs, multiline shell, or literal \\n inside commands.
- For shell scripts, use sh in verification commands unless the repository
  explicitly requires another shell.
- Prefer file-scoped architecture or implementation obligations that a weaker
  local coding model can safely complete in one round.
- If the correct source file cannot be identified from evidence, make one
  narrow checklist item in $checklist_name asking for that specific file choice.

Before finishing, read $checklist_name and verify the result satisfies all
rules. In particular, every "- [ ] " line must contain exactly two literal
${bt} characters total.

Repository file tree excerpt:
$(sed -n '1,500p' "$tree_file")
EOF

printf '%s\n' "architect: asking local OpenCode model $model to rewrite $checklist_path"
title=architect-$(date '+%Y%m%d-%H%M%S')
prompt=$(cat "$prompt_file")
if ! opencode run --dir "$checklist_dir" --model "$model" --title "$title" "$prompt"; then
  die "architect: local OpenCode architecture run failed"
fi

[ -f "$checklist_path" ] || die "architect: checklist disappeared: $checklist_path"
[ -s "$checklist_path" ] || die "architect: checklist is empty after architecture run"

: >"$bad_file"
awk '
  /^[[:space:]]*[-*][[:space:]]+\[/ {
    if ($0 !~ /^[[:space:]]*[-*][[:space:]]+\[( |x)\][[:space:]]/) {
      print
    }
  }
' "$checklist_path" >"$bad_file"
[ ! -s "$bad_file" ] || die "architect: checklist has malformed checkbox lines"

if grep -E '^[[:space:]]+[-*][[:space:]]+\[( |x)\][[:space:]]' "$checklist_path" >/dev/null 2>&1; then
  die "architect: checklist has nested checklist items"
fi
if grep -F "$bt$bt$bt" "$checklist_path" >/dev/null 2>&1; then
  die "architect: checklist contains Markdown code fences"
fi
if grep -F '\n' "$checklist_path" >/dev/null 2>&1; then
  die "architect: checklist contains literal \\n text"
fi
if grep -F '<<' "$checklist_path" >/dev/null 2>&1; then
  die "architect: checklist contains heredoc syntax"
fi
if grep -F '<function=' "$checklist_path" >/dev/null 2>&1 \
  || grep -F '</tool_call>' "$checklist_path" >/dev/null 2>&1; then
  die "architect: checklist contains tool-call markup"
fi

while IFS= read -r completed_line; do
  [ -n "$completed_line" ] || continue
  grep -F -x -- "$completed_line" "$checklist_path" >/dev/null 2>&1 \
    || die "architect: completed item was not preserved: $completed_line"
done <"$completed_file"

grep -E '^[[:space:]]*[-*][[:space:]]+\[ \][[:space:]]' "$checklist_path" \
  >"$unchecked_file" 2>/dev/null || :

while IFS= read -r broad_line; do
  [ -n "$broad_line" ] || continue
  grep -F -x -- "$broad_line" "$checklist_path" >/dev/null 2>&1 \
    && die "architect: broad unchecked item remained after architecture split: $broad_line"
done <"$broad_file"

while IFS= read -r unchecked_line; do
  [ -n "$unchecked_line" ] || continue
  backtick_count=$(printf '%s\n' "$unchecked_line" | awk -F"$bt" '{ print NF - 1 }')
  [ "$backtick_count" = 2 ] \
    || die "architect: unchecked item must contain exactly one backticked verification command: $unchecked_line"
  : >"$paths_file"
  for token in $(printf '%s\n' "$unchecked_line" | tr "$bt\"'(),;:" '        '); do
    case "$token" in
    */*|.*|*.*)
      case "$token" in
      ./*) token=${token#./} ;;
      esac
      [ -f "$checklist_dir/$token" ] || continue
      grep -F -x -- "$token" "$paths_file" >/dev/null 2>&1 || printf '%s\n' "$token" >>"$paths_file"
      ;;
    esac
  done
  path_count=$(wc -l <"$paths_file" | tr -d ' ')
  [ "$path_count" = 1 ] \
    || die "architect: unchecked item must name exactly one existing file path: $unchecked_line"
done <"$unchecked_file"

printf '%s\n' "architect: rewrote $checklist_path with local OpenCode model $model"
