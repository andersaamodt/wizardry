#!/bin/sh

# Repeatedly run OpenCode against a checklist until no unchecked items remain.
# The checklist is authoritative; explicit direction requests stop the loop.

case "${1-}" in
--help|--usage|-h)
  cat <<'USAGE'
Usage: complete-opencode-checklist CHECKLIST [--model PROVIDER/MODEL]

Runs OpenCode in the checklist's directory until CHECKLIST contains no literal
"[ ]" markers. OpenCode output is streamed for every round. Use --model to
select an OpenCode provider/model.

OpenCode is instructed to emit WIZARDRY_CHECKLIST_COMPLETE when it verifies the
whole checklist, or WIZARDRY_CHECKLIST_NEEDS_DIRECTION with a reason when work
cannot continue safely. The file remains the authority for completion.
USAGE
  exit 0
  ;;
esac

require-wizardry || exit 1

set -eu
. env-clear

checklist=${1-}
[ -n "$checklist" ] || die 2 "complete-opencode-checklist: checklist file is required"
shift

model=""
while [ "$#" -gt 0 ]; do
  case "$1" in
  --model)
    shift
    [ "$#" -gt 0 ] || die 2 "complete-opencode-checklist: --model requires a value"
    model=$1
    ;;
  --*)
    die 2 "complete-opencode-checklist: unknown option '$1'"
    ;;
  *)
    die 2 "complete-opencode-checklist: unexpected argument '$1'"
    ;;
  esac
  shift
done

[ -f "$checklist" ] || die "complete-opencode-checklist: checklist is not a regular file: $checklist"
[ -r "$checklist" ] || die "complete-opencode-checklist: checklist is not readable: $checklist"
[ -w "$checklist" ] || die "complete-opencode-checklist: checklist is not writable: $checklist"
has opencode || die 127 "complete-opencode-checklist: opencode is not installed"
has tee || die 127 "complete-opencode-checklist: tee is required"

checklist_dir=$(CDPATH= cd -- "$(dirname "$checklist")" && pwd -P)
checklist_name=${checklist##*/}
checklist_path=$checklist_dir/$checklist_name

if ! grep -F '[ ]' "$checklist_path" >/dev/null 2>&1; then
  success "Checklist is already complete: $checklist_path"
  exit 0
fi

round=0
while grep -F '[ ]' "$checklist_path" >/dev/null 2>&1; do
  round=$((round + 1))
  round_output=$(temp-file "opencode-checklist-round-$round.out")
  round_status=$(temp-file "opencode-checklist-round-$round.status")
  on-exit cleanup-file "$round_output"
  on-exit cleanup-file "$round_status"

  unchecked_before=$(awk 'index($0, "[ ]") { count += 1 } END { print count + 0 }' "$checklist_path")
  printf '\n%s\n' '════════════════════════════════════════════════════════════════'
  printf 'OpenCode round %s — %s unchecked item(s)\n' "$round" "$unchecked_before"
  printf '%s\n\n' '════════════════════════════════════════════════════════════════'

  prompt=$(cat <<EOF
Work autonomously on the repository checklist at:
$checklist_path

Complete every remaining unchecked [ ] item correctly and generally. Read and
follow all repository instructions. Implement, test, and verify the work; mark a
checkbox complete only after its obligation is genuinely satisfied. Preserve
unrelated work and do not use superficial workarounds. Continue through as many
items as this run safely can.

The checklist file is authoritative. If every item is verified complete, end
your response with exactly WIZARDRY_CHECKLIST_COMPLETE. If progress cannot
continue without missing user authority, unavailable credentials, or a material
decision that cannot be inferred safely, end with
WIZARDRY_CHECKLIST_NEEDS_DIRECTION: followed by the concise reason. Do not use
the direction phrase merely because the work is difficult or lengthy.
EOF
)

  (
    set +e
    if [ -n "$model" ]; then
      opencode run --dir "$checklist_dir" --model "$model" "$prompt"
      opencode_status=$?
    else
      opencode run --dir "$checklist_dir" "$prompt"
      opencode_status=$?
    fi
    printf '%s\n' "$opencode_status" >"$round_status"
    exit 0
  ) 2>&1 | tee "$round_output"

  opencode_status=$(sed -n '1p' "$round_status" 2>/dev/null || printf '1')
  case "$opencode_status" in
  ''|*[!0-9]*) opencode_status=1 ;;
  esac

  unchecked_after=$(awk 'index($0, "[ ]") { count += 1 } END { print count + 0 }' "$checklist_path")
  printf '\n%s\n' '────────────────────────────────────────────────────────────────'
  printf 'Wizardry round %s — %s unchecked item(s) remain\n' "$round" "$unchecked_after"
  printf '%s\n' '────────────────────────────────────────────────────────────────'

  if [ "$opencode_status" -ne 0 ]; then
    die "complete-opencode-checklist: OpenCode round $round failed with status $opencode_status"
  fi

  if [ "$unchecked_after" -eq 0 ]; then
    success "Checklist complete after $round OpenCode round(s): $checklist_path"
    exit 0
  fi

  if grep -F 'WIZARDRY_CHECKLIST_NEEDS_DIRECTION' "$round_output" >/dev/null 2>&1; then
    warn "complete-opencode-checklist: OpenCode requested direction with $unchecked_after item(s) remaining"
    exit 1
  fi

  if grep -F 'WIZARDRY_CHECKLIST_COMPLETE' "$round_output" >/dev/null 2>&1; then
    warn "complete-opencode-checklist: OpenCode reported completion, but the checklist still has $unchecked_after unchecked item(s); continuing"
  else
    info "Starting the next OpenCode round"
  fi
done

success "Checklist complete: $checklist_path"
