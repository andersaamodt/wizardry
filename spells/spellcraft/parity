#!/bin/sh

# Open Wizardry's capability audit, test plan, evidence recorder, or router.
# Keeps the familiar `parity COMMAND` interface while each action remains a spell.

case "${1-}" in
--help|--usage|-h)
  cat <<'USAGE'
Usage: parity [report [EVIDENCE-FILE]]
       parity plan [PLATFORM]
       parity record CAPABILITY PLATFORM KIND CHECKS [PREREQUISITES] [EVIDENCE-REFS] [NOTES]
       parity route CAPABILITY PLATFORM DEVICES [GRANTED-SCOPES] [TRANSPORTS]

Run a Parity spell. With no command, show the evidence-backed report.
USAGE
  exit 0
  ;;
esac

set -eu

script_dir=$(CDPATH= cd -- "$(dirname "$0")" && pwd -P)
command_name=${1-report}
if [ "$#" -gt 0 ]; then
  shift
fi

case $command_name in
report|plan|record|route)
  exec "$script_dir/parity-$command_name" "$@"
  ;;
*)
  printf 'parity: unknown command: %s\n' "$command_name" >&2
  printf '%s\n' 'Usage: parity [report|plan|record|route] ...' >&2
  exit 2
  ;;
esac
