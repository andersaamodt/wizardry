#!/bin/sh

# Repeatedly run OpenCode against a checklist until no unchecked items remain.
# The checklist is authoritative; explicit direction requests stop the loop.

case "${1-}" in
--help|--usage|-h)
  cat <<'USAGE'
Usage: loop-code [CHECKLIST] [--model PROVIDER/MODEL]

Runs OpenCode in the checklist's directory until CHECKLIST contains no literal
"[ ]" markers. OpenCode output is streamed for every round. Use --model to
select an OpenCode provider/model.

When CHECKLIST is omitted, loop-code defaults to CHECKLIST.md if present,
otherwise checklist.md.

OpenCode is instructed to emit WIZARDRY_CHECKLIST_COMPLETE when it verifies the
whole checklist. WIZARDRY_CHECKLIST_NEEDS_DIRECTION is honored only when it is
followed by a concrete user-answerable question ending in "?". The file remains
the authority for completion.
USAGE
  exit 0
  ;;
esac

require-wizardry || exit 1

set -eu
. env-clear

checklist=""
model=""
while [ "$#" -gt 0 ]; do
  case "$1" in
  --model)
    shift
    [ "$#" -gt 0 ] || die 2 "loop-code: --model requires a value"
    model=$1
    ;;
  --*)
    die 2 "loop-code: unknown option '$1'"
    ;;
  *)
    [ -z "$checklist" ] || die 2 "loop-code: unexpected argument '$1'"
    checklist=$1
    ;;
  esac
  shift
done

if [ -z "$checklist" ]; then
  if [ -f CHECKLIST.md ]; then
    checklist=CHECKLIST.md
  elif [ -f checklist.md ]; then
    checklist=checklist.md
  else
    die 2 "loop-code: checklist file is required; expected CHECKLIST.md or checklist.md"
  fi
fi

[ -f "$checklist" ] || die "loop-code: checklist is not a regular file: $checklist"
[ -r "$checklist" ] || die "loop-code: checklist is not readable: $checklist"
[ -w "$checklist" ] || die "loop-code: checklist is not writable: $checklist"
has opencode || die 127 "loop-code: opencode is not installed"
has tee || die 127 "loop-code: tee is required"

checklist_dir=$(CDPATH= cd -- "$(dirname "$checklist")" && pwd -P)
checklist_name=${checklist##*/}
checklist_path=$checklist_dir/$checklist_name
checklist_display=$checklist_path
round_divider_min_width=64
case "$checklist_display" in
"$HOME") checklist_display="~" ;;
"$HOME"/*) checklist_display="~${checklist_display#"$HOME"}" ;;
esac

if ! grep -F '[ ]' "$checklist_path" >/dev/null 2>&1; then
  success "Checklist is already complete: $checklist_path"
  exit 0
fi

round=0
while grep -F '[ ]' "$checklist_path" >/dev/null 2>&1; do
  round=$((round + 1))
  round_output=$(temp-file "opencode-checklist-round-$round.out")
  round_status=$(temp-file "opencode-checklist-round-$round.status")
  on-exit cleanup-file "$round_output"
  on-exit cleanup-file "$round_status"

  unchecked_before=$(awk 'index($0, "[ ]") { count += 1 } END { print count + 0 }' "$checklist_path")
  round_header_line=$(printf 'OpenCode round %s — %s unchecked item(s) (%s)' \
    "$round" "$unchecked_before" "$checklist_display")
  round_header_width=$(awk -v line="$round_header_line" 'BEGIN { print length(line) + 2 }')
  if [ "$round_header_width" -lt "$round_divider_min_width" ]; then
    round_header_width=$round_divider_min_width
  fi
  round_header_divider=$(awk -v n="$round_header_width" 'BEGIN { for (i = 0; i < n; i += 1) printf "═" }')
  printf '\n%s\n' "$round_header_divider"
  printf '%s\n' "$round_header_line"
  printf '%s\n\n' "$round_header_divider"

  prompt=$(cat <<EOF
Work autonomously on the repository checklist at:
$checklist_path

Choose the largest coherent batch of unchecked items that can be completed
safely within this round, then complete that batch correctly and generally.
Continue after completing the first checkbox while useful context, time, and
tool budget remain. Stop after one item only when that item was itself
substantial, the next executable items are blocked, or continuing would reduce
correctness. Prefer completing related sibling items together, but never chase
checkbox count by grouping unrelated work or weakening verification. You are
not required to finish the entire checklist in one round; later rounds will
continue it. Prefer concrete implementation over discussing the size of the
remaining roadmap. Make ordinary architectural and staging decisions yourself
from repository evidence. Read and follow all repository instructions.
Implement, test, and verify the work; mark a checkbox complete only after its
obligation is genuinely satisfied. Preserve unrelated work and do not use
superficial workarounds. If one item currently needs unavailable runtime
evidence, leave it unchecked and advance another executable item when possible.

The checklist file is authoritative. If every item is verified complete, end
your response with exactly WIZARDRY_CHECKLIST_COMPLETE. Use
WIZARDRY_CHECKLIST_NEEDS_DIRECTION only when no checklist item can make further
progress until the user answers one specific question whose answer materially
changes the implementation or grants missing authority. Put that concrete
question on the same line after the colon and end it with a question mark. Do
not use the direction phrase because the checklist is broad, architectural,
multi-stage, difficult, lengthy, requires later verification, or cannot all fit
in one run. Those are reasons to complete a bounded slice, not reasons to stop.
EOF
)

  (
    set +e
    if [ -n "$model" ]; then
      opencode run --continue --dir "$checklist_dir" --model "$model" "$prompt"
      opencode_status=$?
    else
      opencode run --continue --dir "$checklist_dir" "$prompt"
      opencode_status=$?
    fi
    printf '%s\n' "$opencode_status" >"$round_status"
    exit 0
  ) 2>&1 | tee "$round_output"

  opencode_status=$(sed -n '1p' "$round_status" 2>/dev/null || printf '1')
  case "$opencode_status" in
  ''|*[!0-9]*) opencode_status=1 ;;
  esac

  unchecked_after=$(awk 'index($0, "[ ]") { count += 1 } END { print count + 0 }' "$checklist_path")
  round_footer_line=$(printf 'Wizardry round %s — %s unchecked item(s) remain (%s)' \
    "$round" "$unchecked_after" "$checklist_display")
  round_footer_width=$(awk -v line="$round_footer_line" 'BEGIN { print length(line) + 2 }')
  if [ "$round_footer_width" -lt "$round_divider_min_width" ]; then
    round_footer_width=$round_divider_min_width
  fi
  round_footer_divider=$(awk -v n="$round_footer_width" 'BEGIN { for (i = 0; i < n; i += 1) printf "─" }')
  printf '\n%s\n' "$round_footer_divider"
  printf '%s\n' "$round_footer_line"
  printf '%s\n' "$round_footer_divider"

  if [ "$opencode_status" -ne 0 ]; then
    if [ "$opencode_status" -eq 130 ]; then
      warn "loop-code: interrupted during OpenCode round $round; rerun loop-code in this directory to resume"
      exit 130
    fi
    die "loop-code: OpenCode round $round failed with status $opencode_status"
  fi

  if [ "$unchecked_after" -eq 0 ]; then
    success "Checklist complete after $round OpenCode round(s): $checklist_path"
    exit 0
  fi

  direction_line=$(
    grep -F 'WIZARDRY_CHECKLIST_NEEDS_DIRECTION:' \
      "$round_output" 2>/dev/null | tail -n 1 || printf ''
  )
  if [ -n "$direction_line" ]; then
    case "$direction_line" in
    *\?)
      warn "loop-code: OpenCode requested direction with $unchecked_after item(s) remaining"
      exit 1
      ;;
    *)
      warn "loop-code: ignored a direction request without a concrete question; continuing"
      ;;
    esac
  fi

  if grep -F 'WIZARDRY_CHECKLIST_COMPLETE' "$round_output" >/dev/null 2>&1; then
    warn "loop-code: OpenCode reported completion, but the checklist still has $unchecked_after unchecked item(s); continuing"
  else
    info "Starting the next OpenCode round"
  fi
done

success "Checklist complete: $checklist_path"
