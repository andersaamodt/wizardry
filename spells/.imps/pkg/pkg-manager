#!/bin/sh
# pkg-manager - detect which package manager is available on supported platforms
# Example: pm=$(pkg-manager) && case $pm in termux) pkg install ;; apt) apt-get install ;; esac
set -eu

case ":${PATH:-}:" in
  *:/data/data/com.termux/files/usr/bin:*|*:/data/user/0/com.termux/files/usr/bin:*)
    if command -v pkg >/dev/null 2>&1; then
      printf '%s\n' termux
      exit 0
    fi
    ;;
esac

if command -v apt-get >/dev/null 2>&1; then echo apt
elif command -v brew >/dev/null 2>&1; then echo brew
elif command -v pacman >/dev/null 2>&1; then echo pacman
elif command -v nix-env >/dev/null 2>&1; then echo nix
elif command -v pkgin >/dev/null 2>&1; then echo pkgin
else exit 1; fi
