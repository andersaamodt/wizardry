#!/bin/sh
# format-timestamp ISO_TIMESTAMP - Format timestamp as human-readable date
# Input: YYYY-MM-DD HH:MM:SS
# Output: "Weekday, Month Day, Year at H:MM AM/PM"
set -eu

timestamp=${1-}

if [ -z "$timestamp" ]; then
  printf '%s\n' "format-timestamp: requires timestamp argument" >&2
  exit 1
fi

python_bin=
if command -v python3 >/dev/null 2>&1; then
  python_bin=python3
elif command -v python >/dev/null 2>&1; then
  python_bin=python
fi

if [ -n "$python_bin" ]; then
  formatted_timestamp=$("$python_bin" - "$timestamp" 2>/dev/null <<'PY'
from datetime import datetime
import sys

timestamp = sys.argv[1]
try:
    dt = datetime.strptime(timestamp, "%Y-%m-%d %H:%M:%S")
except ValueError:
    sys.exit(1)

hour = dt.strftime("%I").lstrip("0") or "0"
print(dt.strftime(f"%A, %B %d, %Y at {hour}:%M %p"))
PY
  ) || formatted_timestamp=
  if [ -n "$formatted_timestamp" ]; then
    printf '%s\n' "$formatted_timestamp"
    exit 0
  fi
fi

if date -j -f '%Y-%m-%d %H:%M:%S' "$timestamp" '+%A, %B %d, %Y at %l:%M %p' >/dev/null 2>&1; then
  date -j -f '%Y-%m-%d %H:%M:%S' "$timestamp" '+%A, %B %d, %Y at %l:%M %p' 2>/dev/null
else
  printf '%s' "$timestamp"
fi
