#!/bin/sh
# log-path TARGET_DIR - Print the operator-local MUD log path for a room or avatar directory

set -eu

target_dir=${1-}
if [ -z "$target_dir" ]; then
  printf '%s\n' "log-path: target directory required" >&2
  exit 1
fi

case "$target_dir" in
  /*) ;;
  *)
    target_dir=$(CDPATH= cd -- "$target_dir" 2>/dev/null && pwd -P) || {
      printf '%s\n' "log-path: target directory does not exist: $target_dir" >&2
      exit 1
    }
    ;;
esac

if [ ! -d "$target_dir" ]; then
  printf '%s\n' "log-path: target directory does not exist: $target_dir" >&2
  exit 1
fi

legacy_log=$target_dir/.log
state_root=${XDG_STATE_HOME:-$HOME/.local/state}/wizardry/mud/logs
mkdir -p "$state_root" || {
  printf '%s\n' "log-path: cannot create log state root" >&2
  exit 1
}

if command -v shasum >/dev/null 2>&1; then
  log_key=$(printf '%s' "$target_dir" | shasum -a 256 | awk '{print $1}' | cut -c1-16)
elif command -v sha256sum >/dev/null 2>&1; then
  log_key=$(printf '%s' "$target_dir" | sha256sum | awk '{print $1}' | cut -c1-16)
else
  log_key=$(printf '%s' "$target_dir" | tr '/ ' '__' | tr -cd '[:alnum:]_.-' | cut -c1-32)
fi
[ -n "$log_key" ] || log_key=room

log_path=$state_root/$log_key.log
if [ -f "$legacy_log" ]; then
  if [ ! -e "$log_path" ]; then
    mv "$legacy_log" "$log_path" 2>/dev/null || cp "$legacy_log" "$log_path" 2>/dev/null || true
    [ -e "$legacy_log" ] && rm -f "$legacy_log" 2>/dev/null || true
  elif [ ! -s "$legacy_log" ]; then
    rm -f "$legacy_log" 2>/dev/null || true
  fi
fi

printf '%s\n' "$log_path"
