#!/bin/sh
# json-extract-string KEY [FILE] - extract the first simple JSON string value for KEY

set -eu

key=${1-}
file=${2-}

if [ -z "$key" ]; then
  printf '%s\n' "json-extract-string: key required" >&2
  exit 1
fi

case "$key" in
  *[!A-Za-z0-9_-]*)
    printf 'json-extract-string: invalid key: %s\n' "$key" >&2
    exit 1
    ;;
esac

json_extract_pattern="s/.*\"$key\":\"\\([^\"]*\\)\".*/\\1/p"

if [ -n "$file" ]; then
  sed -n "$json_extract_pattern" "$file" | sed -n '1p'
else
  sed -n "$json_extract_pattern" | sed -n '1p'
fi
