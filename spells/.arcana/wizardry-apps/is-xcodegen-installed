#!/bin/sh

# Report whether XcodeGen is available.

case "${1-}" in
--help|--usage|-h)
  cat <<'USAGE'
Usage: is-xcodegen-installed

Exits successfully when XcodeGen is available.
USAGE
  exit 0
  ;;
esac

set -eu

script_dir=$(CDPATH= cd -- "$(dirname "$0")" && pwd -P)
. "$script_dir/wizardry-apps-common"
set -eu

wizardry_apps_xcodegen_installed
