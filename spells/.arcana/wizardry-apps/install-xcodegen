#!/bin/sh

# Install XcodeGen from official release assets.

case "${1-}" in
--help|--usage|-h)
  cat <<'USAGE'
Usage: install-xcodegen

Installs XcodeGen for wizardry-apps iOS project generation.
USAGE
  exit 0
  ;;
esac

require-wizardry || exit 1

set -eu
. env-clear

script_dir=$(CDPATH= cd -- "$(dirname "$0")" && pwd -P)
. "$script_dir/wizardry-apps-common"
set -eu

wizardry_apps_install_xcodegen
