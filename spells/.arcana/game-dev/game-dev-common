#!/bin/sh

# Shared helpers for game development arcana.

case "${1-}" in
--help|--usage|-h)
  case "$0" in
    */game-dev-common)
      cat <<'USAGE'
Usage: game-dev-common

Shared helper library for game development installers.
USAGE
      exit 0
      ;;
  esac
  ;;
esac

set +eu

game_dev_data_root() {
  if [ -n "${XDG_DATA_HOME:-}" ]; then
    printf '%s\n' "$XDG_DATA_HOME/wizardry/game-dev"
  else
    printf '%s\n' "$HOME/.local/share/wizardry/game-dev"
  fi
}

game_dev_bin_dir() {
  printf '%s\n' "${XDG_BIN_HOME:-$HOME/.local/bin}"
}

game_dev_godot_root() {
  printf '%s\n' "$(game_dev_data_root)/godot"
}

game_dev_godot_install_dir() {
  printf '%s\n' "$(game_dev_godot_root)/current"
}

game_dev_godot_exec_path() {
  install_dir=$(game_dev_godot_install_dir)
  if [ -x "$install_dir/Godot.app/Contents/MacOS/Godot" ]; then
    printf '%s\n' "$install_dir/Godot.app/Contents/MacOS/Godot"
    return 0
  fi
  find "$install_dir" -maxdepth 2 -type f -name 'Godot_*' -perm -111 2>/dev/null | head -n 1
}

game_dev_godot_app_path() {
  for candidate in \
    "$(game_dev_godot_install_dir)/Godot.app" \
    /Applications/Godot.app \
    "$HOME/Applications/Godot.app"
  do
    [ -d "$candidate" ] || continue
    printf '%s\n' "$candidate"
    return 0
  done
  return 1
}

game_dev_godot_installed() {
  [ -x "$(game_dev_godot_exec_path 2>/dev/null)" ] && return 0
  command -v godot4 >/dev/null 2>&1 && return 0
  command -v godot >/dev/null 2>&1 && return 0
  game_dev_godot_app_path >/dev/null 2>&1
}

game_dev_download_supported() {
  command -v curl >/dev/null 2>&1 || command -v wget >/dev/null 2>&1
}

game_dev_download_to_file() {
  url=$1
  destination=$2
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL -o "$destination" -- "$url"
    return $?
  fi
  if command -v wget >/dev/null 2>&1; then
    wget -qO "$destination" -- "$url"
    return $?
  fi
  return 1
}

game_dev_godot_asset_pattern() {
  case "$(uname -s 2>/dev/null || printf unknown):$(uname -m 2>/dev/null || printf unknown)" in
    Darwin:*) printf '%s\n' 'Godot_v.*_macos[.]universal[.]zip' ;;
    Linux:x86_64|Linux:amd64) printf '%s\n' 'Godot_v.*_linux[.]x86_64[.]zip' ;;
    Linux:aarch64|Linux:arm64) printf '%s\n' 'Godot_v.*_linux[.]arm64[.]zip' ;;
    Linux:i386|Linux:i686) printf '%s\n' 'Godot_v.*_linux[.]x86_32[.]zip' ;;
    *) return 1 ;;
  esac
}

game_dev_release_asset_url() {
  metadata_file=$1
  asset_pattern=$2
  awk -v pattern="$asset_pattern" -F'"' '
    /"browser_download_url"[[:space:]]*:/ {
      for (i = 1; i <= NF; i++) {
        if ($i ~ /^https:/ && $i ~ pattern) {
          print $i
          exit
        }
      }
    }
  ' "$metadata_file"
}

game_dev_link_godot_commands() {
  godot_exec=$1
  bin_dir=$(game_dev_bin_dir)
  mkdir -p "$bin_dir"
  ln -sf "$godot_exec" "$bin_dir/godot"
  ln -sf "$godot_exec" "$bin_dir/godot4"
}

install_godot_main() {
  if game_dev_godot_installed; then
    success "Godot is already installed"
    return 0
  fi

  game_dev_download_supported || die "install-godot: curl or wget is required"
  command -v unzip >/dev/null 2>&1 || die "install-godot: unzip is required"

  asset_pattern=$(game_dev_godot_asset_pattern) || die "install-godot: unsupported host platform"
  metadata_file=$(temp-file)
  archive_file=$(temp-file)
  archive_dir=$(temp-dir)
  on-exit cleanup-file "$metadata_file"
  on-exit cleanup-file "$archive_file"
  on-exit cleanup-dir "$archive_dir"

  step "Fetching Godot release metadata..."
  game_dev_download_to_file \
    https://api.github.com/repos/godotengine/godot/releases/latest \
    "$metadata_file" || die "install-godot: failed to fetch release metadata"

  archive_url=$(game_dev_release_asset_url "$metadata_file" "$asset_pattern")
  [ -n "$archive_url" ] || die "install-godot: release metadata did not include a matching asset"

  step "Downloading Godot..."
  game_dev_download_to_file "$archive_url" "$archive_file" || \
    die "install-godot: failed to download release asset"
  unzip -q "$archive_file" -d "$archive_dir" || die "install-godot: failed to extract release asset"

  install_root=$(game_dev_godot_root)
  staging_dir="$install_root/current.new"
  rm -rf "$staging_dir"
  mkdir -p "$install_root" "$staging_dir"

  case "$(uname -s 2>/dev/null || printf unknown)" in
    Darwin)
      extracted_app=$(find "$archive_dir" -maxdepth 2 -type d -name 'Godot.app' | head -n 1)
      [ -n "$extracted_app" ] || die "install-godot: release asset did not contain Godot.app"
      mv "$extracted_app" "$staging_dir/Godot.app" || die "install-godot: failed to stage Godot.app"
      godot_exec="$staging_dir/Godot.app/Contents/MacOS/Godot"
      ;;
    Linux)
      extracted_exec=$(
        find "$archive_dir" -maxdepth 2 -type f -name 'Godot_*' -perm -111 |
          head -n 1
      )
      [ -n "$extracted_exec" ] || \
        die "install-godot: release asset did not contain a Godot executable"
      extracted_exec_name=$(basename "$extracted_exec")
      mv "$extracted_exec" "$staging_dir/$extracted_exec_name" || \
        die "install-godot: failed to stage Godot executable"
      godot_exec="$staging_dir/$extracted_exec_name"
      ;;
    *)
      die "install-godot: unsupported host platform"
      ;;
  esac

  rm -rf "$(game_dev_godot_install_dir)"
  godot_install_dir=$(game_dev_godot_install_dir)
  mv "$staging_dir" "$godot_install_dir" || \
    die "install-godot: failed to activate install"
  godot_exec=$(game_dev_godot_exec_path)
  [ -x "$godot_exec" ] || die "install-godot: Godot executable was not installed"
  game_dev_link_godot_commands "$godot_exec"
  success "Installed Godot at $(game_dev_godot_install_dir)"
}

uninstall_godot_main() {
  removed=0
  godot_root=$(game_dev_godot_root)
  bin_dir=$(game_dev_bin_dir)
  if [ -d "$godot_root" ]; then
    rm -rf "$godot_root"
    removed=1
  fi
  for link_name in godot godot4; do
    link_path="$bin_dir/$link_name"
    if [ -L "$link_path" ]; then
      link_target=$(readlink "$link_path" 2>/dev/null || printf '')
      case "$link_target" in
        "$godot_root"/*)
          rm -f "$link_path"
          removed=1
          ;;
      esac
    fi
  done

  if [ "$removed" -eq 0 ]; then
    info "Godot is not installed by Wizardry"
    return 0
  fi

  success "Removed Wizardry-managed Godot"
}
