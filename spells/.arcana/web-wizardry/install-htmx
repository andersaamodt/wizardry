#!/bin/sh

# Install htmx and idiomorph JavaScript libraries for web wizardry.

case "${1-}" in
--help|--usage|-h)
  cat <<'USAGE'
Usage: install-htmx

Downloads and installs htmx and idiomorph libraries to a shared directory
for use by web wizardry sites.

Libraries installed:
  - htmx.min.js (v1.9.10)
  - idiomorph-ext.min.js (v0.3.0)
USAGE
  exit 0
  ;;
esac

require-wizardry || exit 1

set -eu
. env-clear

# Shared installation directory for web wizardry JS libraries
install_dir="${WIZARDRY_WEB_JS_DIR:-$HOME/.local/share/wizardry/web/js}"
download_connect_timeout="${WIZARDRY_WEB_DOWNLOAD_CONNECT_TIMEOUT_SECONDS:-10}"
download_timeout="${WIZARDRY_WEB_DOWNLOAD_TIMEOUT_SECONDS:-60}"
download_retries="${WIZARDRY_WEB_DOWNLOAD_RETRIES:-2}"

step "Installing web libraries..."

# Create installation directory
mkdir -p "$install_dir"

# Version-pinned URLs for stability (manual updates to avoid breaking sites)
htmx_url="https://unpkg.com/htmx.org@1.9.10/dist/htmx.min.js"
idiomorph_url="https://unpkg.com/idiomorph@0.3.0/dist/idiomorph-ext.min.js"

# Detect download tool
if has curl; then
  download_tool="curl"
elif has wget; then
  download_tool="wget"
else
  die "install-htmx: curl or wget required"
fi

download_web_library() {
  library_name=$1
  library_url=$2
  library_path=$3
  library_tmp=$(mktemp "${TMPDIR:-/tmp}/wizardry-web-lib.XXXXXX")
  if [ "$download_tool" = "curl" ]; then
    curl -fsSL \
      --connect-timeout "$download_connect_timeout" \
      --max-time "$download_timeout" \
      --retry "$download_retries" \
      --retry-delay 1 \
      "$library_url" -o "$library_tmp" || {
        rm -f "$library_tmp"
        die "install-htmx: failed to download $library_name"
      }
  else
    wget -q \
      --timeout="$download_timeout" \
      --tries="$download_retries" \
      "$library_url" -O "$library_tmp" || {
        rm -f "$library_tmp"
        die "install-htmx: failed to download $library_name"
      }
  fi
  if [ ! -s "$library_tmp" ]; then
    rm -f "$library_tmp"
    die "install-htmx: downloaded empty $library_name"
  fi
  mv "$library_tmp" "$library_path"
}

if [ -f "$install_dir/htmx.min.js" ] && [ -f "$install_dir/idiomorph-ext.min.js" ]; then
  success "Web libraries already installed to $install_dir"
else
  info "Downloading htmx.min.js..."
  download_web_library "htmx" "$htmx_url" "$install_dir/htmx.min.js"

  info "Downloading idiomorph-ext.min.js..."
  download_web_library "idiomorph" "$idiomorph_url" "$install_dir/idiomorph-ext.min.js"
fi

success "Web libraries installed to $install_dir"
info "  - htmx.min.js (v1.9.10)"
info "  - idiomorph-ext.min.js (v0.3.0)"
