#!/bin/sh

# Install and activate the recommended "best" Tabby model.

case "${1-}" in
--help|--usage|-h)
  cat <<'USAGE'
Usage: install-best-tabby-llm

Installs and activates the recommended best local model for Tabby.
USAGE
  exit 0
  ;;
esac

set -eu
. env-clear

script_dir=$(CDPATH= cd -- "$(dirname "$0")" && pwd)

runtime=$("$script_dir/get-active-llm-runtime" 2>/dev/null || printf 'ollama')
if [ "$runtime" != "ollama" ]; then
  die "install-best-tabby-llm: Tabby model management currently requires ollama runtime"
fi

best_model=${TABBY_BEST_LLM_MODEL:-qwen3-coder:30b}

printf '%s\n' "Installing best Tabby LLM: $best_model"
"$script_dir/install-llm" "$best_model"
"$script_dir/set-tabby-llm" "$best_model"
