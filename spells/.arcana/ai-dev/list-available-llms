#!/bin/sh

# List available/recommended LLMs.

case "${1-}" in
--help|--usage|-h)
  cat <<'USAGE'
Usage: list-available-llms [RUNTIME]

Lists curated/recommended LLMs for the active runtime or the provided runtime.
USAGE
  exit 0
  ;;
esac

set -eu
. env-clear

script_dir=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
# shellcheck source=/dev/null
. "$script_dir/ai-dev-llm-common"
set -eu

runtime=${1-}
if [ -z "$runtime" ]; then
  runtime=$(ai_llm_resolve_runtime)
fi

if ! ai_llm_runtime_valid "$runtime"; then
  die 2 "list-available-llms: invalid runtime '$runtime'"
fi

ai_llm_list_available "$runtime"
