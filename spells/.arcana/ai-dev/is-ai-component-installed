#!/bin/sh

# Check if an AI development component is installed.

case "${1-}" in
--help|--usage|-h)
  cat <<'USAGE'
Usage: is-ai-component-installed COMPONENT

Checks if the specified AI development component is installed.

Supported components: tabby, ollama, mlx, opencode, anythingllm

Returns: 0 if installed, 1 if not installed
USAGE
  exit 0
  ;;
esac

set -eu
. env-clear

script_dir=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
# shellcheck source=/dev/null
. "$script_dir/ai-dev-llm-common"
set -eu

component=${1-}
if [ -z "$component" ]; then
  exit 1
fi

if [ "${AI_DEV_FORCE_NONE:-0}" = "1" ]; then
  exit 1
fi

case "$component" in
tabby)
  # Check if tabby binary exists
  if has tabby; then
    exit 0
  fi
  # Check in common install locations
  for path in \
    /usr/local/bin/tabby \
    /opt/homebrew/bin/tabby \
    /usr/bin/tabby \
    "$HOME/.local/bin/tabby" \
    "$HOME/bin/tabby"; do
    if [ -x "$path" ]; then
      exit 0
    fi
  done
  exit 1
  ;;
ollama)
  # Check if ollama binary exists
  if has ollama; then
    exit 0
  fi
  # Check in common install locations
  for path in /usr/local/bin/ollama /usr/bin/ollama "$HOME/.local/bin/ollama"; do
    if [ -x "$path" ]; then
      exit 0
    fi
  done
  exit 1
  ;;
mlx)
  if ! ai_llm_is_mlx_supported; then
    exit 1
  fi
  if [ -x "$ai_llm_mlx_python" ] && [ -f "$ai_llm_mlx_root/installed" ]; then
    exit 0
  fi
  exit 1
  ;;
opencode)
  if [ "${AI_DEV_OPENCODE_PATH+x}" = "x" ]; then
    [ -x "$AI_DEV_OPENCODE_PATH" ]
    exit $?
  fi
  if has opencode; then
    exit 0
  fi
  for path in \
    /usr/local/bin/opencode \
    /usr/bin/opencode \
    "$HOME/.local/bin/opencode" \
    "$HOME/.opencode/bin/opencode" \
    "$HOME/bin/opencode"; do
    if [ -x "$path" ]; then
      exit 0
    fi
  done
  exit 1
  ;;
anythingllm)
  # Check if AnythingLLM is installed
  # AnythingLLM installs to different locations depending on platform
  if [ "$(uname -s 2>/dev/null)" = "Darwin" ]; then
    # macOS: check for app bundle variants in Applications folders
    anythingllm_app_pattern="*AnythingLLM*.app"
    if find /Applications "$HOME/Applications" -maxdepth 1 -type d \
      -name "$anythingllm_app_pattern" 2>/dev/null | \
      head -1 | grep -q .; then
      exit 0
    fi
  else
    # Linux: check for wrapper command or managed AppImage install
    for path in \
      /usr/local/bin/anythingllm \
      "$HOME/.local/bin/anythingllm" \
      /opt/anythingllm/anythingllm \
      "$HOME/.local/lib/anythingllm/AnythingLLM.AppImage" \
      "$HOME/.local/lib/anythingllm/AnythingLLMDesktop.AppImage" \
      "$HOME/AnythingLLMDesktop.AppImage"; do
      if [ -x "$path" ]; then
        exit 0
      fi
    done
  fi
  exit 1
  ;;
*)
  exit 1
  ;;
esac
