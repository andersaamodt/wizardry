#!/bin/sh

# Print the currently selected ai-dev LLM runtime.

case "${1-}" in
--help|--usage|-h)
  cat <<'USAGE'
Usage: get-active-llm-runtime

Prints the active local LLM runtime used by wizardry (mlx or ollama).
USAGE
  exit 0
  ;;
esac

set -eu
. env-clear

script_dir=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
# shellcheck source=/dev/null
. "$script_dir/ai-dev-llm-common"
set -eu

ai_llm_resolve_runtime
