#!/bin/sh

# Uninstall an LLM model.

case "${1-}" in
--help|--usage|-h)
  cat <<'USAGE'
Usage: uninstall-llm MODEL

Removes an LLM model from the active runtime.

Example: uninstall-llm llama2:7b
USAGE
  exit 0
  ;;
esac

set -eu
. env-clear

script_dir=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
# shellcheck source=/dev/null
. "$script_dir/ai-dev-llm-common"
set -eu

model=${1-}
if [ -z "$model" ]; then
  die 2 "uninstall-llm: MODEL required"
fi

runtime=$(ai_llm_resolve_runtime)

if ! "$script_dir/is-ai-component-installed" "$runtime" 2>/dev/null; then
  die "uninstall-llm: $(ai_llm_runtime_label "$runtime") is not installed"
fi

say "Uninstalling LLM model from $(ai_llm_runtime_label "$runtime"): $model"

case "$runtime" in
  ollama)
    if has ollama; then
      ollama_bin="ollama"
    elif [ -x "$HOME/.local/bin/ollama" ]; then
      ollama_bin="$HOME/.local/bin/ollama"
    else
      die "uninstall-llm: ollama binary not found"
    fi
    "$ollama_bin" rm "$model" || die "uninstall-llm: failed to uninstall $model"
    ;;
  mlx)
    [ -x "$ai_llm_mlx_python" ] || die "uninstall-llm: mlx runtime is incomplete"
    "$ai_llm_mlx_python" -m mlx_lm.manage remove --model "$model" >/dev/null 2>&1 || \
      die "uninstall-llm: failed to uninstall $model"
    ai_llm_unregister_mlx_model "$model" || true
    ;;
esac

selected=$(ai_llm_get_selected_model "$runtime" 2>/dev/null || printf '')
if [ "$selected" = "$model" ]; then
  ai_llm_set_selected_model "$runtime" "$(ai_llm_default_model "$runtime")" || true
fi

if ! ai_llm_sync_opencode_runtime; then
  warn "uninstall-llm: OpenCode runtime sync failed"
fi

success "LLM model uninstalled: $model"
