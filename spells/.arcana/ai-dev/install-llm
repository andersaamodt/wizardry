#!/bin/sh

# Install an LLM model.

case "${1-}" in
--help|--usage|-h)
  cat <<'USAGE'
Usage: install-llm MODEL

Downloads and installs an LLM model using the active runtime.

Examples:
  install-llm qwen3-coder:30b
  install-llm mlx-community/Qwen3-Coder-30B-A3B-Instruct-5bit
USAGE
  exit 0
  ;;
esac

set -eu
. env-clear

script_dir=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
# shellcheck source=/dev/null
. "$script_dir/ai-dev-llm-common"
set -eu

model=${1-}
if [ -z "$model" ]; then
  die 2 "install-llm: MODEL required"
fi

resolve_model_alias() {
  case "$1" in
    llava:latest) printf '%s\n' "llava:13b" ;;
    *) printf '%s\n' "$1" ;;
  esac
}

runtime=$(ai_llm_resolve_runtime)

if ! "$script_dir/is-ai-component-installed" "$runtime" 2>/dev/null; then
  die "install-llm: $(ai_llm_runtime_label "$runtime") is not installed"
fi

pull_target=$model
if [ "$runtime" = "ollama" ]; then
  pull_target=$(resolve_model_alias "$model")
fi

if ! ai_llm_is_curated_model "$runtime" "$pull_target"; then
  die "install-llm: unknown model '$model' for runtime '$runtime'. Use select-llm-to-install to choose a curated model."
fi

printf '%s\n' "Installing LLM model for $(ai_llm_runtime_label "$runtime"): $pull_target"

case "$runtime" in
  ollama)
    if ! "$script_dir/is-ollama-daemon-running" >/dev/null 2>&1; then
      die "install-llm: could not connect to the ollama server. ollama server must be running to add LLMs."
    fi

    if has ollama; then
      ollama_bin="ollama"
    elif [ -x "$HOME/.local/bin/ollama" ]; then
      ollama_bin="$HOME/.local/bin/ollama"
    else
      die "install-llm: ollama binary not found"
    fi

    ollama_home="$HOME/.ollama"
    ollama_key="$ollama_home/id_ed25519"
    if [ ! -f "$ollama_key" ]; then
      mkdir -p "$ollama_home"
      if has ssh-keygen; then
        printf '%s\n' "Generating ollama identity key..."
        ssh-keygen -q -t ed25519 -N "" -f "$ollama_key" >/dev/null 2>&1 \
          || die "install-llm: failed to generate $ollama_key"
      else
        die "install-llm: missing $ollama_key and ssh-keygen is unavailable"
      fi
    fi

    "$ollama_bin" pull "$pull_target" || die "install-llm: failed to install $pull_target"
    ;;
  mlx)
    [ -x "$ai_llm_mlx_python" ] || die "install-llm: mlx runtime is incomplete"
    if ! ai_llm_mlx_runtime_ready; then
      die "install-llm: mlx runtime is not ready. Re-run install-mlx to repair it."
    fi
    AI_DEV_MLX_MODEL="$pull_target" "$ai_llm_mlx_python" - <<'PY' >/dev/null 2>&1 || \
      die "install-llm: failed to install $pull_target"
import os
from huggingface_hub import snapshot_download

model = os.environ["AI_DEV_MLX_MODEL"]
snapshot_download(repo_id=model)
PY
    ai_llm_register_mlx_model "$pull_target" || die "install-llm: failed to register installed model"
    ;;
esac

ai_llm_set_selected_model "$runtime" "$pull_target" || true

if [ "$runtime" = "mlx" ]; then
  ai_llm_start_mlx_server "$pull_target" || warn "install-llm: mlx server did not become ready"
fi

if ! ai_llm_sync_opencode_runtime; then
  warn "install-llm: OpenCode runtime sync failed"
fi

if [ "$pull_target" != "$model" ]; then
  warn "install-llm: '$model' was redirected to '$pull_target'"
fi

success "LLM model installed: $pull_target"
