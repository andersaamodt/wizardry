#!/bin/sh

# Shared helpers for ai-dev runtime/model selection and OpenCode wiring.

case "${1-}" in
--help|--usage|-h)
  case "$0" in
    */ai-dev-llm-common)
      cat <<'USAGE'
Usage: ai-dev-llm-common

Shared helper library for AI runtime/model management in the ai-dev arcanum.
USAGE
      exit 0
      ;;
  esac
  ;;
esac

set +eu

ai_llm_state_home=${XDG_STATE_HOME:-$HOME/.local/state}
ai_llm_root_dir=${AI_DEV_STATE_DIR:-$ai_llm_state_home/wizardry/ai-dev}
ai_llm_runtime_file=$ai_llm_root_dir/active-runtime
ai_llm_model_file_prefix=$ai_llm_root_dir/selected-model-
ai_llm_mlx_models_file=$ai_llm_root_dir/mlx-installed-models
ai_llm_mlx_root=$ai_llm_root_dir/mlx
ai_llm_mlx_venv=$ai_llm_mlx_root/venv
ai_llm_mlx_python=$ai_llm_mlx_venv/bin/python
ai_llm_mlx_port=${AI_DEV_MLX_PORT:-11435}
ai_llm_mlx_pid_file=$ai_llm_root_dir/mlx-server.pid
ai_llm_mlx_log=$ai_llm_root_dir/mlx-server.log
ai_llm_opencode_config_dir=${XDG_CONFIG_HOME:-$HOME/.config}/opencode
ai_llm_opencode_runtime_config=$ai_llm_opencode_config_dir/wizardry-runtime.json

ai_llm_uname_s() {
  uname -s 2>/dev/null || printf 'unknown\n'
}

ai_llm_uname_m() {
  uname -m 2>/dev/null || printf 'unknown\n'
}

ai_llm_is_macos() {
  [ "$(ai_llm_uname_s)" = "Darwin" ]
}

ai_llm_is_mlx_supported() {
  case "${AI_DEV_MLX_SUPPORTED-}" in
    1|true|TRUE|yes|YES|on|ON) return 0 ;;
    0|false|FALSE|no|NO|off|OFF) return 1 ;;
  esac

  if ! ai_llm_is_macos; then
    return 1
  fi
  case "$(ai_llm_uname_m)" in
    arm64|aarch64) return 0 ;;
    *) return 1 ;;
  esac
}

ai_llm_default_runtime() {
  if ai_llm_is_mlx_supported; then
    printf '%s\n' "mlx"
  else
    printf '%s\n' "ollama"
  fi
}

ai_llm_runtime_valid() {
  case "$1" in
    ollama|mlx) return 0 ;;
    *) return 1 ;;
  esac
}

ai_llm_runtime_label() {
  case "$1" in
    mlx) printf '%s\n' "MLX" ;;
    ollama) printf '%s\n' "ollama" ;;
    *) printf '%s\n' "$1" ;;
  esac
}

ai_llm_component_installed() {
  component=$1
  if [ -n "${script_dir-}" ] && [ -x "$script_dir/is-ai-component-installed" ]; then
    "$script_dir/is-ai-component-installed" "$component" >/dev/null 2>&1
    return $?
  fi
  return 1
}

ai_llm_mlx_runtime_ready() {
  [ -x "$ai_llm_mlx_python" ] || return 1
  "$ai_llm_mlx_python" - <<'PY' >/dev/null 2>&1
import mlx_lm  # noqa: F401
import huggingface_hub  # noqa: F401
PY
}

ai_llm_get_active_runtime() {
  runtime=${AI_DEV_LLM_RUNTIME:-}
  if ai_llm_runtime_valid "$runtime"; then
    printf '%s\n' "$runtime"
    return 0
  fi

  if [ -f "$ai_llm_runtime_file" ]; then
    runtime=$(tr -d '\r' <"$ai_llm_runtime_file" 2>/dev/null || printf '')
    if ai_llm_runtime_valid "$runtime"; then
      printf '%s\n' "$runtime"
      return 0
    fi
  fi

  ai_llm_default_runtime
}

ai_llm_resolve_runtime() {
  runtime=$(ai_llm_get_active_runtime)
  if ai_llm_component_installed "$runtime"; then
    printf '%s\n' "$runtime"
    return 0
  fi

  default_runtime=$(ai_llm_default_runtime)
  if ai_llm_component_installed "$default_runtime"; then
    printf '%s\n' "$default_runtime"
    return 0
  fi

  if ai_llm_component_installed "mlx"; then
    printf '%s\n' "mlx"
    return 0
  fi
  if ai_llm_component_installed "ollama"; then
    printf '%s\n' "ollama"
    return 0
  fi

  printf '%s\n' "$default_runtime"
}

ai_llm_set_active_runtime() {
  runtime=$1
  ai_llm_runtime_valid "$runtime" || return 1
  mkdir -p "$ai_llm_root_dir"
  printf '%s\n' "$runtime" >"$ai_llm_runtime_file"
}

ai_llm_default_model() {
  case "$1" in
    mlx)
      printf '%s\n' "mlx-community/Qwen3-Coder-30B-A3B-Instruct-5bit"
      ;;
    ollama)
      printf '%s\n' "qwen3-coder:30b"
      ;;
    *)
      return 1
      ;;
  esac
}

ai_llm_model_file() {
  runtime=$1
  printf '%s%s\n' "$ai_llm_model_file_prefix" "$runtime"
}

ai_llm_get_selected_model() {
  runtime=$1
  model_file=$(ai_llm_model_file "$runtime") || return 1
  if [ -f "$model_file" ]; then
    model=$(tr -d '\r' <"$model_file" 2>/dev/null || printf '')
    if [ -n "$model" ]; then
      printf '%s\n' "$model"
      return 0
    fi
  fi
  ai_llm_default_model "$runtime"
}

ai_llm_set_selected_model() {
  runtime=$1
  model=$2
  [ -n "$model" ] || return 1
  model_file=$(ai_llm_model_file "$runtime") || return 1
  mkdir -p "$ai_llm_root_dir"
  printf '%s\n' "$model" >"$model_file"
}

ai_llm_list_available() {
  runtime=$1
  case "$runtime" in
    mlx)
      printf '%s\n' "mlx-community/Qwen3-Coder-30B-A3B-Instruct-5bit|best coding (required)|18.0|256"
      printf '%s\n' "mlx-community/Qwen3-Coder-Next-5bit|best coding fast variant (required)|14.0|256"
      printf '%s\n' "mlx-community/Qwen2.5-14B-Instruct-4bit|best reasoning|8.2|128"
      printf '%s\n' "mlx-community/Qwen2.5-VL-7B-Instruct-4bit|best vision|4.9|32"
      ;;
    ollama)
      printf '%s\n' "qwen3-coder:30b|best coding|19.0|256"
      printf '%s\n' "llama3.1:70b|best reasoning|43.0|128"
      printf '%s\n' "llava:13b|best vision|8.0|8"
      ;;
    *)
      return 1
      ;;
  esac
}

ai_llm_is_curated_model() {
  runtime=$1
  candidate=$2
  list=$(ai_llm_list_available "$runtime" 2>/dev/null || printf '')
  while IFS= read -r llm_entry; do
    [ -n "$llm_entry" ] || continue
    curated_model=${llm_entry%%|*}
    if [ "$candidate" = "$curated_model" ]; then
      return 0
    fi
  done <<EOF
$list
EOF
  return 1
}

ai_llm_runtime_supported_on_host() {
  runtime=$1
  case "$runtime" in
    ollama) return 0 ;;
    mlx) ai_llm_is_mlx_supported ;;
    *) return 1 ;;
  esac
}

ai_llm_register_mlx_model() {
  model=$1
  mkdir -p "$ai_llm_root_dir"
  if [ -f "$ai_llm_mlx_models_file" ] && grep -Fx "$model" "$ai_llm_mlx_models_file" >/dev/null 2>&1; then
    return 0
  fi
  printf '%s\n' "$model" >>"$ai_llm_mlx_models_file"
}

ai_llm_unregister_mlx_model() {
  model=$1
  [ -f "$ai_llm_mlx_models_file" ] || return 0
  filtered=$(mktemp "${TMPDIR:-/tmp}/ai-dev-mlx-models.XXXXXX")
  grep -Fvx "$model" "$ai_llm_mlx_models_file" >"$filtered" 2>/dev/null || true
  mv "$filtered" "$ai_llm_mlx_models_file"
}

ai_llm_list_registered_mlx_models() {
  [ -f "$ai_llm_mlx_models_file" ] || return 0
  tr -d '\r' <"$ai_llm_mlx_models_file" 2>/dev/null || true
}

ai_llm_mlx_model_registered() {
  model=$1
  [ -f "$ai_llm_mlx_models_file" ] || return 1
  grep -Fx "$model" "$ai_llm_mlx_models_file" >/dev/null 2>&1
}

ai_llm_write_opencode_runtime_config() {
  runtime=$1
  model=$2
  mkdir -p "$ai_llm_opencode_config_dir"
  temp=$(mktemp "${TMPDIR:-/tmp}/opencode-wizardry-runtime.XXXXXX")

  case "$runtime" in
    mlx)
      cat >"$temp" <<'EOF'
{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "mlx": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "MLX (local)",
      "options": {
        "baseURL": "http://127.0.0.1:__MLX_PORT__/v1"
      }
    }
  },
  "model": "mlx/__MODEL__"
}
EOF
      sed -e "s|__MLX_PORT__|$ai_llm_mlx_port|g" -e "s|__MODEL__|$model|g" "$temp" >"$temp.out"
      mv "$temp.out" "$temp"
      ;;
    ollama)
      cat >"$temp" <<'EOF'
{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      }
    }
  },
  "model": "ollama/__MODEL__"
}
EOF
      sed "s|__MODEL__|$model|g" "$temp" >"$temp.out"
      mv "$temp.out" "$temp"
      ;;
    *)
      return 1
      ;;
  esac

  mv "$temp" "$ai_llm_opencode_runtime_config"
}

ai_llm_wait_for_mlx_server() {
  attempts=0
  while [ "$attempts" -lt 30 ]; do
    if command -v curl >/dev/null 2>&1 && curl -fsS "http://127.0.0.1:$ai_llm_mlx_port/v1/models" >/dev/null 2>&1; then
      return 0
    fi
    attempts=$((attempts + 1))
    sleep 1
  done
  return 1
}

ai_llm_start_mlx_server() {
  model=$1
  [ -x "$ai_llm_mlx_python" ] || return 1
  mkdir -p "$ai_llm_root_dir"

  if ai_llm_wait_for_mlx_server; then
    return 0
  fi

  if [ -f "$ai_llm_mlx_pid_file" ]; then
    old_pid=$(tr -d '\r' <"$ai_llm_mlx_pid_file" 2>/dev/null || printf '')
    if [ -n "$old_pid" ] && kill -0 "$old_pid" 2>/dev/null; then
      if ai_llm_wait_for_mlx_server; then
        return 0
      fi
    fi
  fi

  nohup "$ai_llm_mlx_python" -m mlx_lm.server \
    --model "$model" \
    --host 127.0.0.1 \
    --port "$ai_llm_mlx_port" \
    >"$ai_llm_mlx_log" 2>&1 &
  printf '%s\n' "$!" >"$ai_llm_mlx_pid_file"

  ai_llm_wait_for_mlx_server
}

ai_llm_sync_opencode_runtime() {
  runtime=$(ai_llm_resolve_runtime)
  model=$(ai_llm_get_selected_model "$runtime")
  ai_llm_write_opencode_runtime_config "$runtime" "$model" || return 1
  if [ "$runtime" = "mlx" ] && ai_llm_component_installed "mlx"; then
    if ai_llm_mlx_model_registered "$model"; then
      ai_llm_start_mlx_server "$model" || return 1
    fi
  fi
  return 0
}
