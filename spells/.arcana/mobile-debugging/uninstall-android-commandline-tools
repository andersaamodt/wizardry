#!/bin/sh

# Remove Android SDK command-line tools from mobile debugging tool roots.

case "${1-}" in
--help|--usage|-h)
  cat <<'USAGE'
Usage: uninstall-android-commandline-tools

Removes Android SDK command-line tools from Theurgy's mobile debugging quarantine roots.
USAGE
  exit 0
  ;;
esac

require-wizardry || exit 1

set -eu
. env-clear

script_dir=$(CDPATH= cd -- "$(dirname "$0")" && pwd -P)
. "$script_dir/mobile-debugging-common"
set -eu

uninstall_android_commandline_tools_main
