#!/bin/sh
# Install Android platform tools in the isolated mobile-debugging root.

case "${1-}" in
--help|--usage|-h)
  cat <<'USAGE'
Usage: install-android-platform-tools

Installs Android platform tools into Theurgy's mobile debugging quarantine root.
USAGE
  exit 0
  ;;
esac

require-wizardry || exit 1

set -eu
. env-clear

script_dir=$(CDPATH= cd -- "$(dirname "$0")" && pwd -P)
. "$script_dir/mobile-debugging-common"
set -eu

install_android_platform_tools_main
