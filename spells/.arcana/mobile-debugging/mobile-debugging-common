#!/bin/sh

# Shared helpers for mobile-debugging arcana and firewalled adb.

case "${1-}" in
--help|--usage|-h)
  case "$0" in
    */mobile-debugging-common)
      cat <<'USAGE'
Usage: mobile-debugging-common

Shared helper library for mobile debugging installers and wrappers.
USAGE
      exit 0
      ;;
  esac
  ;;
esac

set +eu

mobile_debugging_data_root() {
  if [ -n "${XDG_DATA_HOME:-}" ]; then
    printf '%s\n' "$XDG_DATA_HOME/wizardry/mobile-debugging"
  else
    printf '%s\n' "$HOME/.local/share/wizardry/mobile-debugging"
  fi
}

mobile_debugging_sdk_root() {
  printf '%s\n' "$(mobile_debugging_data_root)/android-sdk"
}

mobile_debugging_platform_tools_dir() {
  printf '%s\n' "$(mobile_debugging_sdk_root)/platform-tools"
}

mobile_debugging_adb_path() {
  printf '%s\n' "$(mobile_debugging_platform_tools_dir)/adb"
}

mobile_debugging_maestro_root() {
  printf '%s\n' "$(mobile_debugging_data_root)/maestro-cli"
}

mobile_debugging_maestro_install_dir() {
  printf '%s\n' "$(mobile_debugging_maestro_root)/current"
}

mobile_debugging_maestro_bin_dir() {
  printf '%s\n' "$(mobile_debugging_maestro_install_dir)/bin"
}

mobile_debugging_maestro_path() {
  printf '%s\n' "$(mobile_debugging_maestro_bin_dir)/maestro"
}

mobile_debugging_java_exec() {
  if command -v java >/dev/null 2>&1; then
    command -v java
    return 0
  fi
  return 1
}

mobile_debugging_python3_exec() {
  if command -v python3 >/dev/null 2>&1; then
    command -v python3
    return 0
  fi
  return 1
}

mobile_debugging_java_ready() {
  mobile_debugging_java=$(mobile_debugging_java_exec || true)
  [ -n "$mobile_debugging_java" ] || return 1
  "$mobile_debugging_java" -version >/dev/null 2>&1
}

mobile_debugging_sdkmanager_exec() {
  if command -v sdkmanager >/dev/null 2>&1; then
    command -v sdkmanager
    return 0
  fi
  return 1
}

mobile_debugging_adb_exec() {
  mobile_debugging_installed_adb=$(mobile_debugging_adb_path)
  if [ -x "$mobile_debugging_installed_adb" ]; then
    printf '%s\n' "$mobile_debugging_installed_adb"
    return 0
  fi
  if command -v adb >/dev/null 2>&1; then
    command -v adb
    return 0
  fi
  return 1
}

mobile_debugging_maestro_exec() {
  mobile_debugging_installed_maestro=$(mobile_debugging_maestro_path)
  if [ -x "$mobile_debugging_installed_maestro" ]; then
    printf '%s\n' "$mobile_debugging_installed_maestro"
    return 0
  fi
  if command -v maestro >/dev/null 2>&1; then
    command -v maestro
    return 0
  fi
  return 1
}

mobile_debugging_platform_tools_installed() {
  [ -x "$(mobile_debugging_adb_path)" ]
}

mobile_debugging_maestro_installed() {
  [ -x "$(mobile_debugging_maestro_path)" ]
}

mobile_debugging_sha256_exec() {
  if command -v sha256sum >/dev/null 2>&1; then
    printf '%s\n' "sha256sum"
    return 0
  fi
  if command -v shasum >/dev/null 2>&1; then
    printf '%s\n' "shasum -a 256"
    return 0
  fi
  if command -v openssl >/dev/null 2>&1; then
    printf '%s\n' "openssl dgst -sha256 -r"
    return 0
  fi
  return 1
}

mobile_debugging_download_supported() {
  command -v curl >/dev/null 2>&1 || command -v wget >/dev/null 2>&1
}

mobile_debugging_download_to_file() {
  url=$1
  destination=$2
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL -o "$destination" -- "$url"
    return $?
  fi
  if command -v wget >/dev/null 2>&1; then
    wget -qO "$destination" -- "$url"
    return $?
  fi
  return 1
}

mobile_debugging_maestro_release_api_url() {
  printf '%s\n' "${MOBILE_DEBUGGING_MAESTRO_RELEASE_API_URL:-https://api.github.com/repos/mobile-dev-inc/Maestro/releases/latest}"
}

mobile_debugging_extract_json_string() {
  json_file=$1
  field_name=$2
  python3_exec=$(mobile_debugging_python3_exec || true)
  if [ -n "$python3_exec" ]; then
    "$python3_exec" - "$json_file" "$field_name" <<'PY'
import json
import sys

with open(sys.argv[1], 'r', encoding='utf-8') as handle:
    data = json.load(handle)

value = data.get(sys.argv[2], "")
if isinstance(value, str):
    print(value)
PY
    return 0
  fi
  sed -n 's/.*"'"$field_name"'":[[:space:]]*"\([^"]*\)".*/\1/p' "$json_file" | head -n 1
}

mobile_debugging_maestro_asset_field() {
  json_file=$1
  asset_name=$2
  field_name=$3
  python3_exec=$(mobile_debugging_python3_exec || true)
  if [ -n "$python3_exec" ]; then
    "$python3_exec" - "$json_file" "$asset_name" "$field_name" <<'PY'
import json
import sys

with open(sys.argv[1], 'r', encoding='utf-8') as handle:
    data = json.load(handle)

for asset in data.get("assets", []):
    if asset.get("name") == sys.argv[2]:
        value = asset.get(sys.argv[3], "")
        if isinstance(value, str):
            print(value)
        break
PY
    return 0
  fi
  awk -v asset="$asset_name" -v key="$field_name" '
    BEGIN {
      in_object = 0
      asset_match = 0
    }
    /{/ {
      in_object = 1
      asset_match = 0
    }
    {
      if (in_object && $0 ~ "\"" "name" "\"[[:space:]]*:[[:space:]]*\"" asset "\"") {
        asset_match = 1
      }
      if (in_object && asset_match && $0 ~ "\"" key "\"[[:space:]]*:[[:space:]]*\"") {
        line = $0
        sub(".*\"" key "\"[[:space:]]*:[[:space:]]*\"", "", line)
        sub("\".*", "", line)
        print line
        exit
      }
    }
    /^[[:space:]]*}[,]?[[:space:]]*$/ {
      in_object = 0
      asset_match = 0
    }
  ' "$json_file"
}

mobile_debugging_sha256_file() {
  file_path=$1
  sha_cmd=$(mobile_debugging_sha256_exec || true)
  [ -n "$sha_cmd" ] || die "mobile-debugging: no sha256 tool found"
  # shellcheck disable=SC2086
  set -- $sha_cmd "$file_path"
  "$@" | awk '{print $1}'
}

install_android_platform_tools_main() {
  if mobile_debugging_platform_tools_installed; then
    success "Android platform tools already installed at $(mobile_debugging_platform_tools_dir)"
    return 0
  fi

  sdk_root=$(mobile_debugging_sdk_root)
  mkdir -p "$sdk_root"

  case "$(uname -s 2>/dev/null || printf unknown)" in
    Darwin)
      archive_url=https://dl.google.com/android/repository/platform-tools-latest-darwin.zip
      ;;
    Linux)
      archive_url=https://dl.google.com/android/repository/platform-tools-latest-linux.zip
      ;;
    *)
      die "install-android-platform-tools: unsupported host platform"
      ;;
  esac

  if ! mobile_debugging_download_supported; then
    die "install-android-platform-tools: curl or wget is required"
  fi

  command -v unzip >/dev/null 2>&1 || die "install-android-platform-tools: unzip is required"

  archive_file=$(temp-file)
  archive_dir=$(temp-dir)
  on-exit cleanup-file "$archive_file"
  on-exit cleanup-dir "$archive_dir"

  step "Downloading Android platform tools into $sdk_root..."
  mobile_debugging_download_to_file "$archive_url" "$archive_file" || die "install-android-platform-tools: download failed"

  rm -rf "$(mobile_debugging_platform_tools_dir)"
  unzip -q "$archive_file" -d "$archive_dir" || die "install-android-platform-tools: unzip failed"
  [ -d "$archive_dir/platform-tools" ] || die "install-android-platform-tools: archive did not contain platform-tools"
  mv "$archive_dir/platform-tools" "$sdk_root/platform-tools" || die "install-android-platform-tools: failed to stage platform-tools"

  mobile_debugging_platform_tools_installed || die "install-android-platform-tools: adb was not installed"
  success "Installed Android platform tools at $(mobile_debugging_platform_tools_dir)"
}

install_maestro_cli_main() {
  if mobile_debugging_maestro_installed; then
    success "Maestro CLI already installed at $(mobile_debugging_maestro_install_dir)"
    if ! mobile_debugging_java_ready; then
      info "Java 17+ is still required before Maestro can run."
    fi
    return 0
  fi

  command -v unzip >/dev/null 2>&1 || die "install-maestro-cli: unzip is required"

  mobile_debugging_download_supported || die "install-maestro-cli: curl or wget is required"

  maestro_root=$(mobile_debugging_maestro_root)
  metadata_file=$(temp-file)
  archive_file=$(temp-file)
  archive_dir=$(temp-dir)
  on-exit cleanup-file "$metadata_file"
  on-exit cleanup-file "$archive_file"
  on-exit cleanup-dir "$archive_dir"

  release_api_url=$(mobile_debugging_maestro_release_api_url)
  step "Fetching Maestro CLI release metadata..."
  mobile_debugging_download_to_file "$release_api_url" "$metadata_file" || die "install-maestro-cli: failed to fetch release metadata"

  release_tag=$(mobile_debugging_extract_json_string "$metadata_file" "tag_name")
  [ -n "$release_tag" ] || die "install-maestro-cli: release metadata did not include a tag"

  archive_url=$(mobile_debugging_maestro_asset_field "$metadata_file" "maestro.zip" "browser_download_url")
  archive_sha=$(mobile_debugging_maestro_asset_field "$metadata_file" "maestro.zip" "digest")
  [ -n "$archive_url" ] || die "install-maestro-cli: release metadata did not include maestro.zip"
  archive_sha=${archive_sha#sha256:}

  step "Downloading Maestro CLI $release_tag..."
  mobile_debugging_download_to_file "$archive_url" "$archive_file" || die "install-maestro-cli: failed to download maestro.zip"

  if [ -n "$archive_sha" ]; then
    actual_sha=$(mobile_debugging_sha256_file "$archive_file")
    [ "$actual_sha" = "$archive_sha" ] || die "install-maestro-cli: sha256 mismatch for maestro.zip"
  fi

  unzip -q "$archive_file" -d "$archive_dir" || die "install-maestro-cli: unzip failed"

  extracted_maestro=$(find "$archive_dir" -type f -path '*/bin/maestro' | head -n 1)
  [ -n "$extracted_maestro" ] || die "install-maestro-cli: archive did not contain bin/maestro"
  extracted_root=$(dirname "$(dirname "$extracted_maestro")")

  mkdir -p "$maestro_root"
  staging_dir="$maestro_root/current.new"
  rm -rf "$staging_dir"

  if [ "$extracted_root" = "$archive_dir" ]; then
    mkdir -p "$staging_dir"
    cp -R "$archive_dir"/. "$staging_dir"/ || die "install-maestro-cli: failed to stage Maestro CLI"
  else
    mv "$extracted_root" "$staging_dir" || die "install-maestro-cli: failed to move extracted Maestro CLI"
  fi

  printf '%s\n' "$release_tag" >"$staging_dir/RELEASE_TAG"
  rm -rf "$(mobile_debugging_maestro_install_dir)"
  mv "$staging_dir" "$(mobile_debugging_maestro_install_dir)" || die "install-maestro-cli: failed to activate install"

  mobile_debugging_maestro_installed || die "install-maestro-cli: maestro was not installed"

  if mobile_debugging_java_ready; then
    success "Installed Maestro CLI $release_tag at $(mobile_debugging_maestro_install_dir)"
  else
    success "Installed Maestro CLI $release_tag at $(mobile_debugging_maestro_install_dir)"
    info "Java 17+ is not available yet; Maestro may not run until Java is installed."
  fi
}

uninstall_android_platform_tools_main() {
  sdk_root=$(mobile_debugging_sdk_root)
  if [ ! -d "$sdk_root" ]; then
    info "Android platform tools are not installed"
    return 0
  fi

  rm -rf "$sdk_root"
  success "Removed Android platform tools from $sdk_root"
}

uninstall_maestro_cli_main() {
  maestro_root=$(mobile_debugging_maestro_root)
  if [ ! -d "$maestro_root" ]; then
    info "Maestro CLI is not installed"
    return 0
  fi

  rm -rf "$maestro_root"
  success "Removed Maestro CLI from $maestro_root"
}
