#!/bin/sh

# Run one audio file through the selected external voice-recognition runtime.

case "${1-}" in
  --help|--usage|-h)
    cat <<'USAGE'
Usage: voice-recognition-transcribe AUDIO_PATH [LANGUAGE]

Print the local transcription from the selected installed backend.
USAGE
    exit 0
    ;;
esac

script_dir=$(CDPATH= cd -- "$(dirname "$0")" && pwd -P)
if ! command -v require-wizardry >/dev/null 2>&1; then
  wizardry_dir=$(CDPATH= cd -- "$script_dir/../../.." && pwd -P)
  PATH="$wizardry_dir/spells/.imps/sys:$wizardry_dir/spells/.imps/out:$wizardry_dir/spells/.imps/cond:$wizardry_dir/spells/.imps/pkg:$wizardry_dir/spells/cantrips:$PATH"
  export PATH WIZARDRY_DIR="$wizardry_dir"
fi
require-wizardry || exit 1

set -eu
. env-clear

audio_path=${1-}
language=${2-}
[ -n "$audio_path" ] && [ "$#" -le 2 ] || {
  printf '%s\n' 'voice-recognition-transcribe: AUDIO_PATH is required' >&2
  exit 2
}
[ -f "$audio_path" ] || {
  printf '%s\n' 'voice-recognition-transcribe: audio file not found' >&2
  exit 1
}

VR_ARCANA_DIR=$script_dir
export VR_ARCANA_DIR
# shellcheck source=/dev/null
. "$script_dir/voice-recognition-common"

backend=$(vr_select_backend 2>/dev/null || printf '')
[ -n "$backend" ] || {
  printf '%s\n' 'voice-recognition-transcribe: no installed backend found' >&2
  exit 1
}
python_bin=$(vr_component_python "$backend")
model_name=$(vr_component_model "$backend")
[ -x "$python_bin" ] || {
  printf '%s\n' 'voice-recognition-transcribe: selected backend is unavailable' >&2
  exit 1
}

DICTATE_AUDIO_PATH="$audio_path" \
DICTATE_BACKEND="$backend" \
DICTATE_MODEL="$model_name" \
DICTATE_LANGUAGE="$language" \
HF_HOME="${WIZARDRY_VOICE_RECOGNITION_HF_HOME:-${XDG_CACHE_HOME:-$HOME/.cache}/wizardry/voice-recognition/huggingface}" \
HF_HUB_OFFLINE=1 \
TRANSFORMERS_OFFLINE=1 \
"$python_bin" <<'PY'
import os
import sys

backend = os.environ.get("DICTATE_BACKEND", "")
audio_path = os.environ.get("DICTATE_AUDIO_PATH", "")
model_name = os.environ.get("DICTATE_MODEL", "")
language = os.environ.get("DICTATE_LANGUAGE", "").strip() or None

def squash(text):
    return " ".join(str(text or "").strip().split())

text = ""
try:
    if backend == "ctranslate2-whisper":
        from faster_whisper import WhisperModel
        model = WhisperModel(model_name, device="auto", compute_type="int8")
        kwargs = {"vad_filter": True}
        if language:
            kwargs["language"] = language
        segments, _info = model.transcribe(audio_path, **kwargs)
        text = " ".join(squash(getattr(segment, "text", "")) for segment in segments if squash(getattr(segment, "text", "")))
    elif backend == "mlx-whisper":
        import mlx_whisper
        kwargs = {"path_or_hf_repo": model_name}
        if language:
            kwargs["language"] = language
        result = mlx_whisper.transcribe(audio_path, **kwargs)
        if isinstance(result, dict):
            text = squash(result.get("text", ""))
    elif backend == "parakeet":
        import nemo.collections.asr as nemo_asr
        model = nemo_asr.models.ASRModel.from_pretrained(model_name=model_name)
        try:
            outputs = model.transcribe([audio_path])
        except TypeError:
            outputs = model.transcribe([audio_path], batch_size=1)
        item = outputs[0] if isinstance(outputs, list) and outputs else outputs
        if hasattr(item, "text"):
            text = squash(getattr(item, "text", ""))
        elif isinstance(item, dict):
            text = squash(item.get("text", ""))
        else:
            text = squash(item)
    else:
        raise RuntimeError("unknown backend")
except Exception as exc:
    sys.stderr.write(str(exc))
    sys.exit(1)

text = squash(text)
if not text:
    sys.stderr.write("no speech detected")
    sys.exit(1)
sys.stdout.write(text)
PY
