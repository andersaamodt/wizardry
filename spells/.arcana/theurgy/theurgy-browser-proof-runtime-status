#!/bin/sh

# Print Theurgy browser proof runtime installer status.

case "${1-}" in
--help|--usage|-h)
  cat <<'USAGE'
Usage: theurgy-browser-proof-runtime-status

Reports whether the Theurgy browser proof runtime installer is available.
USAGE
  exit 0
  ;;
esac

set -eu
script_dir=$(CDPATH= cd -- "$(dirname "$0")" && pwd -P)
. "$script_dir/_theurgy"

if [ -x "$theurgy_home/spells/install-theurgy-browser-proof-runtime" ]; then
  printf 'available\n'
else
  printf 'not installed\n'
fi
