#!/bin/sh

# Banish files to the trash for later recall. Safer than `rm`.

case "${1-}" in
--help|--usage|-h)
  cat << 'USAGE'
Usage: trash [-r] [-f] <file|folder>...

Move files or folders to the system trash so they remain recoverable. Use -r for directories and -f to ignore missing files.
USAGE
  exit 0
  ;;
esac

set -eu
. env-clear

recursive=0
force=0

# Parse options
while [ "$#" -gt 0 ]; do
  case "$1" in
  -r|--recursive)
    recursive=1
    shift
    ;;
  -f|--force)
    force=1
    shift
    ;;
  -rf|-fr)
    recursive=1
    force=1
    shift
    ;;
  --)
    shift
    break
    ;;
  -*)
    usage-error "trash" "unknown option: $1"
    ;;
  *)
    break
    ;;
  esac
done

if [ "$#" -eq 0 ]; then
  printf '%s\n' "trash: missing file operand" >&2
  exit 2
fi

# Validate operands before requiring a platform trash backend. Missing paths and
# non-recursive directories are input errors on every host; `-f` with only
# missing operands is already complete and must not require a GUI bridge.
exit_status=0
trash_has_operand=0
for file in "$@"; do
  if [ ! -e "$file" ]; then
    if [ "$force" -eq 1 ]; then
      continue
    fi
    printf '%s\n' "trash: cannot trash '$file': No such file or directory" >&2
    exit_status=1
    continue
  fi
  if [ -d "$file" ] && [ "$recursive" -eq 0 ]; then
    printf '%s\n' "trash: cannot trash '$file': Is a directory (use -r to trash directories)" >&2
    exit_status=1
    continue
  fi
  trash_has_operand=1
done

if [ "$exit_status" -ne 0 ]; then
  exit "$exit_status"
fi
if [ "$trash_has_operand" -eq 0 ]; then
  exit 0
fi

# Detect the OS
if command -v detect-distro >/dev/null 2>&1; then
  platform=$(detect-distro 2>/dev/null || printf 'unknown')
  case "$platform" in
  mac)
    os=mac
    ;;
  *)
    os=linux
    ;;
  esac
else
  kernel=$(uname -s 2>/dev/null || printf 'unknown')
  case "$kernel" in
  Darwin)
    os=mac
    ;;
  Linux)
    os=linux
    ;;
  *)
    os=unknown
    ;;
  esac
fi

# Detect the best trash command available
case "$os" in
mac)
  if [ -x "${THEURGY_HOME:-$HOME/theurgy}/spells/macos-ui" ]; then
    trash_cmd=theurgy-macos
  else
    trash_cmd=none
  fi
  ;;
linux)
  if command -v gio >/dev/null 2>&1; then
    trash_cmd=gio
  elif command -v trash-put >/dev/null 2>&1; then
    trash_cmd=trash-put
  elif command -v kioclient5 >/dev/null 2>&1; then
    trash_cmd=kioclient5
  else
    trash_cmd=none
  fi
  ;;
*)
  trash_cmd=none
  ;;
esac

if [ "$trash_cmd" = "none" ]; then
  printf '%s\n' "trash: no supported trash utility found for your system." >&2
  case "$os" in
  mac)
    printf '%s\n' "Install Theurgy to enable the macOS trash capability." >&2
    ;;
  linux)
    printf '%s\n' "Install one of: gio, trash-cli (for trash-put), or kde-cli-tools (for kioclient5)." >&2
    ;;
  *)
    printf '%s\n' "Your operating system is not supported." >&2
    ;;
  esac
  exit 1
fi

for file in "$@"; do
  # Check if file exists
  if [ ! -e "$file" ]; then
    if [ "$force" -eq 1 ]; then
      continue
    fi
    printf '%s\n' "trash: cannot trash '$file': No such file or directory" >&2
    exit_status=1
    continue
  fi

  # Check if it's a directory and -r is not specified
  if [ -d "$file" ] && [ "$recursive" -eq 0 ]; then
    printf '%s\n' "trash: cannot trash '$file': Is a directory (use -r to trash directories)" >&2
    exit_status=1
    continue
  fi

  # Perform the trash operation based on available command
  case "$trash_cmd" in
  theurgy-macos)
    if ! "${THEURGY_HOME:-$HOME/theurgy}/spells/macos-ui" trash "$file" >/dev/null 2>&1; then
      printf '%s\n' "trash: failed to trash '$file'" >&2
      exit_status=1
    fi
    ;;
  gio)
    if [ "$force" -eq 1 ]; then
      if ! gio trash -f -- "$file" 2>/dev/null; then
        true  # Ignore errors when force is enabled
      fi
    else
      if ! gio trash -- "$file"; then
        printf '%s\n' "trash: failed to trash '$file'" >&2
        exit_status=1
      fi
    fi
    ;;
  trash-put)
    if [ "$force" -eq 1 ]; then
      if ! trash-put -- "$file" 2>/dev/null; then
        true  # Ignore errors when force is enabled
      fi
    else
      if ! trash-put -- "$file"; then
        printf '%s\n' "trash: failed to trash '$file'" >&2
        exit_status=1
      fi
    fi
    ;;
  kioclient5)
    # kioclient5 requires absolute paths
    case "$file" in
    /*)
      abs_path=$file
      ;;
    *)
      abs_path="$(pwd)/$file"
      ;;
    esac
    
    if [ "$force" -eq 1 ]; then
      if ! kioclient5 move "$abs_path" trash:/ 2>/dev/null; then
        true  # Ignore errors when force is enabled
      fi
    else
      if ! kioclient5 move "$abs_path" trash:/; then
        printf '%s\n' "trash: failed to trash '$file'" >&2
        exit_status=1
      fi
    fi
    ;;
  esac
done

exit $exit_status
